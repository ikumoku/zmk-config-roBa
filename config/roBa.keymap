#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define BLUETOOTH 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp LC(LG(LEFT))>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        gowindow1 {
            bindings = <&kp LC(LG(RIGHT))>;
            key-positions = <8 9>;
        };

        vol_up {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <5 6>;
        };

        vol_down {
            bindings = <&kp C_VOL_DN>;
            key-positions = <17 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                        &kp T                                                          &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                        &kp G        &kp LS(LG(S))                      &kp MINUS      &kp H        &kp J  &kp K      &kp L    &kp SEMI
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                        &kp B        &kp COLON                          &lt 6 LG(TAB)  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT    &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 7 INT_HENKAN  &lt 1 SPACE  &lt_to_layer_0 3 INT_MUHENKAN      &kp BACKSPACE  &lt 2 ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>, <&inc_dec_kp C B>;
        };

        FUNCTION {
            bindings = <
&kp ESC    &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp F12    &kp F13                               &kp F1          &kp F2          &kp F3           &kp F4  &kp DELETE
&kp LC(A)  &kp LC(S)         &trans            &kp F5     &kp F6   &kp LC(F)      &kp F13       &kp F6          &kp F7          &kp F8           &kp F9  &kp F10
&kp LC(Z)  &kp LC(Y)         &kp LC(C)         &kp LC(V)  &trans   &trans         &kp UP_ARROW  &kp DOWN_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW  &trans  &kp F11
&trans     &trans            &trans            &trans     &trans   &trans         &trans        &trans                                                   &kp F12
            >;
        };

        NUM {
            bindings = <
&kp KP_ASTERISK           &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTRK                                      &kp LEFT_PARENTHESIS  &kp EXCLAMATION  &kp AMPERSAND     &kp LESS_THAN      &kp GREATER_THAN
&kp COLON                 &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RIGHT_BRACKET  &trans      &kp UNDERSCORE  &kp BACKSLASH         &kp MINUS        &kp LEFT_BRACKET  &kp LS(BACKSLASH)  &kp SQT
&mt LEFT_SHIFT LS(MINUS)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RIGHT_BRACE    &trans      &trans          &kp PIPE              &kp LS(N5)       &kp LS(NUMBER_6)  &kp LS(NUMBER_7)   &kp RS(EQUAL)
&kp PERIOD                &kp NUMBER_0  &trans        &trans        &trans             &trans      &trans          &trans                                                                      &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                             &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &kp LS(LG(S))  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans         &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mo 5   &mkp MB2  &mkp MB3
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &mkp MB4  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans               &trans              &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LA(RIGHT_ARROW)  &kp LA(LEFT_ARROW)  &trans  &trans  &kp LCTRL
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans               &trans              &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &kp LC(F)     &trans  &trans      &trans       &bt BT_NXT    &bt BT_PRV    &trans        &trans        &bt BT_NXT
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&kp A             &kp LS(MINUS)     &kp A            &kp RS(A)   &kp LS(A)                         &kp BSLH              &kp NON_US_BSLH           &kp NUMBER_8           &kp NUMBER_0              &kp MINUS
&kp LS(N8)        &kp LS(NUMBER_8)  &kp KP_NUMBER_8  &kp RS(N8)  &kp ASTRK  &trans      &trans     &kp LCTRL             &kp LC(NON_US_BACKSLASH)  &kp AT_SIGN            &kp LS(LEFT_BRACKET)      &kp LEFT_BRACKET
&kp LEFT_SHIFT    &kp UNDERSCORE    &kp UNDERSCORE   &kp A       &kp A      &trans      &trans     &kp SEMICOLON         &kp COLON                 &kp RS(RIGHT_BRACKET)  &kp LS(NON_US_BACKSLASH)  &kp RIGHT_BRACKET
&kp LEFT_CONTROL  &kp A             &kp LS(N9)       &trans      &trans     &trans      &kp SLASH  &kp NON_US_BACKSLASH                                                                             &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
